new file mode 100644
index 0000000..d66063f
--- /dev/null
+++ b/packaging/server/plervo-canvas-backup.service
@@ -0,0 +1,20 @@
+# Nightly backup of plervo-canvas-server's data directory (an example; docs/server.md, "Backups").
+# install.sh installs it with plervo-canvas-backup.timer; turn it on with
+#   sudo systemctl enable --now plervo-canvas-backup.timer
+# It checks there is room for the copy (twice the data directory's size free), stops the server
+# for the few seconds the copy takes (apps reconnect on their own), writes
+# /var/backups/plervo-canvas-server/plervo-canvas-YYYY-MM-DD.tar.gz (readable by root only) and keeps the last
+# 7 days. The archives hold every file, the addresses files came from, the reports and the server
+# key: keep them, and any copy off the machine, as private as the server itself.
+
+[Unit]
+Description=Back up plervo-canvas-server's data directory
+After=plervo-canvas-server.service
+
+[Service]
+Type=oneshot
+Nice=10
+IOSchedulingClass=idle
+UMask=0077
+# `$$` and `%%` are a literal `$` and `%` for the shell (systemd expands the single ones).
+ExecStart=/bin/sh -ec 'dir=/var/backups/plervo-canvas-server; install -d -m 700 "$$dir"; need=$$(du -sk /var/lib/plervo-canvas-server | cut -f1); free=$$(df -k --output=avail "$$dir" | tail -n 1); if [ "$$free" -lt $$((need * 2)) ]; then echo "not enough free space for a backup ($$free KiB free, $$need KiB of data)" >&2; exit 1; fi; systemctl stop plervo-canvas-server; trap "systemctl start plervo-canvas-server" EXIT; tar -C /var/lib -czf "$$dir/plervo-canvas-$$(date +%%F).tar.gz" plervo-canvas-server; find "$$dir" -name "plervo-canvas-*.tar.gz" -mtime +7 -delete'
diff --git a/packaging/server/plervo-canvas-backup.timer b/packaging/server/plervo-canvas-backup.timer
new file mode 100644
index 0000000..9d0d27c
--- /dev/null
+++ b/packaging/server/plervo-canvas-backup.timer
@@ -0,0 +1,14 @@
+# Runs plervo-canvas-backup.service every night (see that file).
+#   sudo systemctl enable --now plervo-canvas-backup.timer
+#   systemctl list-timers plervo-canvas-backup.timer
+
+[Unit]
+Description=Nightly backup of plervo-canvas-server's data directory
+
+[Timer]
+OnCalendar=*-*-* 04:00:00
+RandomizedDelaySec=30min
+Persistent=true
+
+[Install]
+WantedBy=timers.target
diff --git a/packaging/server/plervo-canvas-server.service b/packaging/server/plervo-canvas-server.service
new file mode 100644
index 0000000..37ce97a
--- /dev/null
+++ b/packaging/server/plervo-canvas-server.service
@@ -0,0 +1,64 @@
+# systemd unit for plervo-canvas-server; setup in docs/server.md ("Deploy on a Linux server").
+# Install: sudo cp plervo-canvas-server.service /etc/systemd/system/ && sudo systemctl daemon-reload
+#          sudo systemctl enable --now plervo-canvas-server
+# Logs:    journalctl -u plervo-canvas-server
+
+[Unit]
+Description=Plervo Canvas collaboration server
+Documentation=https://github.com/alportblu/plervo-pdf/blob/main/docs/server.md
+Wants=network-online.target
+After=network-online.target
+
+[Service]
+Type=simple
+User=plervo-canvas
+Group=plervo-canvas
+ExecStart=/usr/local/bin/plervo-canvas-server --config /etc/plervo-canvas-server/server.toml
+# SIGTERM (systemctl stop/restart) stops it gracefully: open files are saved and compacted, and
+# apps are told the server is restarting (they reconnect when it is back).
+KillSignal=SIGTERM
+TimeoutStopSec=30
+Restart=on-failure
+RestartSec=2
+# max_connections (512 by default) plus the files kept open.
+LimitNOFILE=4096
+UMask=0077
+# Under memory pressure this service slows down, then it alone is stopped (and restarted), not the
+# rest of the machine.
+MemoryHigh=60%
+MemoryMax=75%
+# It talks only to the proxy on this machine (listen = "127.0.0.1:47900"). Listening on a network
+# address without a proxy in front needs these two lines removed.
+IPAddressAllow=localhost
+IPAddressDeny=any
+
+# Hardening: the only writable place is the data directory.
+NoNewPrivileges=yes
+ProtectSystem=strict
+ReadWritePaths=/var/lib/plervo-canvas-server
+ProtectHome=yes
+PrivateTmp=yes
+PrivateDevices=yes
+ProtectKernelTunables=yes
+ProtectKernelModules=yes
+ProtectKernelLogs=yes
+ProtectControlGroups=yes
+ProtectClock=yes
+ProtectHostname=yes
+ProtectProc=invisible
+ProcSubset=pid
+CapabilityBoundingSet=
+AmbientCapabilities=
+RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
+RestrictNamespaces=yes
+RestrictRealtime=yes
+RestrictSUIDSGID=yes
+LockPersonality=yes
+MemoryDenyWriteExecute=yes
+RemoveIPC=yes
+SystemCallArchitectures=native
+SystemCallFilter=@system-service
+SystemCallErrorNumber=EPERM
+
+[Install]
+WantedBy=multi-user.target
