new file mode 100644
index 0000000..d5ae186
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.canvas.yml
@@ -0,0 +1,73 @@
+# Flatpak manifest for Plervo Canvas, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.canvas.yml
+#   flatpak run com.plervo.canvas
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# The single-file .flatpak attached to each release comes from com.plervo.canvas.bundle.yml,
+# which repackages the prebuilt release binaries. Keep runtime-version and finish-args identical.
+#
+# Official release binaries embed craft-fonts (storytold/craft-fonts, OFL fonts); this from-source
+# build doesn't (add it as a git source and set CRAFT_FONTS_DIR to include it), so it uses the
+# runtime's system fonts.
+id: com.plervo.canvas
+runtime: org.freedesktop.Platform
+runtime-version: '26.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-canvas
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
+  # drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Pictures and Documents are granted so files passed by path (the command
+  # line, Open Recent, "Save" next to the original) work in the usual places.
+  - --filesystem=xdg-pictures
+  - --filesystem=xdg-documents
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.canvas` exposes it to
+  # host agents) and home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-canvas
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-canvas/cargo
+        CARGO_NET_OFFLINE: 'true'
+        # .cargo/config.toml points CRAFT_FONTS_DIR at ../craft-fonts for local builds; there is
+        # none here, so build without it (a warning, not an error).
+        CRAFT_FONTS_DIR: /nonexistent
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-canvas
+      - install -Dm755 target/release/plervo-canvas /app/bin/plervo-canvas
+      - install -Dm644 packaging/linux/com.plervo.canvas.desktop /app/share/applications/com.plervo.canvas.desktop
+      - install -Dm644 packaging/linux/com.plervo.canvas.mime.xml /app/share/mime/packages/com.plervo.canvas.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.canvas.metainfo.xml.in > /app/share/metainfo/com.plervo.canvas.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
