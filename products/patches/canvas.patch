+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Overrides for the setup wizard's WixUI strings, so its pages name the version being installed
+  ([FigcraftVersion] is the full version, pre-release tag included, set in plervo-canvas.wxs).
+-->
+<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
+  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}Welcome to the [ProductName] [FigcraftVersion] Setup Wizard" />
+  <String Id="WelcomeDlgDescription" Value="The Setup Wizard will install [ProductName] version [FigcraftVersion] on your computer. Click Next to continue or Cancel to exit the Setup Wizard." />
+  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}Ready to install [ProductName] [FigcraftVersion]" />
+  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}Completed the [ProductName] [FigcraftVersion] Setup Wizard" />
+</WixLocalization>
diff --git a/packaging/windows/plervo-canvas.wxs b/packaging/windows/plervo-canvas.wxs
new file mode 100644
index 0000000..c35e781
--- /dev/null
+++ b/packaging/windows/plervo-canvas.wxs
@@ -0,0 +1,131 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Plervo Canvas MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
+  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:
+
+    wix build plervo-canvas.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
+      -culture en-US -loc plervo-canvas.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
+      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi
+
+  Per-machine install with a setup wizard that names the version: Welcome, install folder
+  (Program Files\Plervo Canvas by default, remembered for upgrades), Ready, a progress page, and a
+  Finish page with a ticked "Launch Plervo Canvas" box. Installs a Start Menu shortcut, makes
+  Plervo Canvas the owner of `.plervo-canvas`, and offers it under "Open with" for SVG, PNG and JPEG
+  (without taking over the user's default app for them), plus plervo-canvas-cli when HasCli=1.
+  `msiexec /qn` still installs silently.
+
+  UpgradeCode is fixed for Plervo Canvas forever (generated once; never reuse another app's).
+-->
+<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
+     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
+  <Package
+      Name="Plervo Canvas"
+      Manufacturer="Maintech Solutions LLC"
+      Version="$(var.Version)"
+      UpgradeCode="10B07941-A89D-5B5B-B651-B9B8970A85DC"
+      Scope="perMachine"
+      Compressed="yes"
+      Language="1033">
+    <SummaryInformation Description="Plervo Canvas interface design and prototyping tool" Manufacturer="Maintech Solutions LLC" />
+    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
+         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
+    <MajorUpgrade AllowSameVersionUpgrades="yes"
+        DowngradeErrorMessage="A newer version of Plervo Canvas is already installed." />
+    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
+
+    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
+         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
+    <Icon Id="FigcraftIcon.exe" SourceFile="$(var.IconPath)" />
+    <Property Id="ARPPRODUCTICON" Value="FigcraftIcon.exe" />
+    <Property Id="ARPURLINFOABOUT" Value="https://plervo.com/" />
+    <Property Id="ARPURLUPDATEINFO" Value="https://plervo.com/" />
+    <Property Id="ARPHELPLINK" Value="https://buymeacoffee.com/alport" />
+
+    <StandardDirectory Id="ProgramFiles6432Folder">
+      <Directory Id="INSTALLFOLDER" Name="Plervo Canvas" />
+    </StandardDirectory>
+    <StandardDirectory Id="ProgramMenuFolder" />
+
+    <!-- An upgrade installs where the user put the previous version (written by FigcraftApp). -->
+    <Property Id="INSTALLFOLDER">
+      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Plervo Canvas" Name="InstallDir" Type="raw" />
+    </Property>
+
+    <Feature Id="Main" Title="Plervo Canvas" Level="1">
+      <ComponentGroupRef Id="FigcraftFiles" />
+    </Feature>
+
+    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
+         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
+    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
+    <UI>
+      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
+      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
+      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFigcraft"
+          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
+    </UI>
+    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
+    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
+    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
+
+    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
+         pages through plervo-canvas.en-us.wxl. -->
+    <Property Id="FigcraftVersion" Value="$(var.DisplayVersion)" />
+
+    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
+    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Plervo Canvas $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
+    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Plervo Canvas" />
+    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
+    <Property Id="WixShellExecTarget" Value="[#FigcraftExe]" />
+    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
+    <CustomAction Id="LaunchFigcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
+    <Feature Id="PlervoLicenseFeature" Title="Licenses" Level="1"><ComponentGroupRef Id="PlervoLegalFiles" /></Feature>
+  </Package>
+
+  <Fragment>
+    <ComponentGroup Id="FigcraftFiles" Directory="INSTALLFOLDER">
+      <Component Id="FigcraftApp" Guid="6DD8CC3B-101F-5B9D-B8A3-657762828941">
+        <File Id="FigcraftExe" Source="$(var.BinDir)\plervo-canvas.exe" KeyPath="yes">
+          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Plervo Canvas"
+              Description="Plervo Canvas interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
+              Icon="FigcraftIcon.exe" IconIndex="0" />
+        </File>
+
+        <!-- .plervo-canvas: Plervo Canvas's own format; Plervo Canvas is its default app. -->
+        <ProgId Id="PlervoCanvas.Document" Description="Plervo Canvas Document" Icon="FigcraftExe" IconIndex="0">
+          <Extension Id="plervo-canvas" ContentType="application/x-plervo-canvas">
+            <Verb Id="open" Command="Open" TargetFile="FigcraftExe" Argument="&quot;%1&quot;" />
+          </Extension>
+        </ProgId>
+        <!-- SVG and images: offered under "Open with", never forced as the default. -->
+        <ProgId Id="PlervoCanvas.Image" Description="Image" Icon="FigcraftExe" IconIndex="0" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\PlervoCanvas.Image\shell\open\command" Value="&quot;[#FigcraftExe]&quot; &quot;%1&quot;" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="PlervoCanvas.Image" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="PlervoCanvas.Image" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="PlervoCanvas.Image" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="PlervoCanvas.Image" Value="" Type="string" />
+
+        <!-- "Open with" app list and the Run dialog (Win+R "plervo-canvas"). -->
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe" Name="FriendlyAppName" Value="Plervo Canvas" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe\shell\open\command" Value="&quot;[#FigcraftExe]&quot; &quot;%1&quot;" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe\SupportedTypes" Name=".plervo-canvas" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe\SupportedTypes" Name=".png" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\plervo-canvas.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\plervo-canvas.exe" Value="[#FigcraftExe]" Type="string" />
+        <RegistryValue Root="HKLM" Key="Software\Plervo Canvas" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
+      </Component>
+
+<?if $(var.HasCli) = 1 ?>
+      <Component Id="FigcraftCli">
+        <File Id="FigcraftCliExe" Source="$(var.BinDir)\plervo-canvas-cli.exe" KeyPath="yes" />
+      </Component>
+<?endif?>
+    </ComponentGroup>
+  </Fragment>
+  <Fragment>
+    <DirectoryRef Id="INSTALLFOLDER"><Directory Id="PlervoLegalDir" Name="Licenses" /></DirectoryRef>
+    <ComponentGroup Id="PlervoLegalFiles" Directory="PlervoLegalDir"><Files Include="$(var.BinDir)\Licenses\*" /></ComponentGroup>
+  </Fragment>
+</Wix>
