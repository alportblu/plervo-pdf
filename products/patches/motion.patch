index 0000000..95f7462
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.motion.yml
@@ -0,0 +1,76 @@
+# Flatpak manifest for Plervo Motion, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.motion.yml
+#   flatpak run com.plervo.motion
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+#
+# com.plervo.motion.bundle.yml (same directory) builds the .flatpak attached to each
+# release from the release's Linux tarball. Keep runtime-version and finish-args identical in both
+# (packaging-lint checks this).
+id: com.plervo.motion
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-motion
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu compositor and renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Audio preview and playback (cpal through ALSA, which the runtime routes to PulseAudio or
+  # PipeWire's Pulse server).
+  - --socket=pulseaudio
+  # The optional trained models (Settings ▸ Roto Brush, Settings ▸ Face Tracking) download only
+  # when the user asks, over HTTPS with curl. It also lets host agents reach the optional
+  # --control server (127.0.0.1). No telemetry: nothing else uses the network.
+  - --share=network
+  # Open/Save and import dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
+  # drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Pictures, Videos and Documents are granted so files passed by path (the
+  # command line, Open Recent, footage a project links to, Render Queue output) work in the
+  # usual places.
+  - --filesystem=xdg-pictures
+  - --filesystem=xdg-videos
+  - --filesystem=xdg-documents
+  # Deliberately not granted: home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-motion
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-motion/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-motion -p plervo-motion-cli
+      - install -Dm755 target/release/plervo-motion /app/bin/plervo-motion
+      - install -Dm755 target/release/plervo-motion-cli /app/bin/plervo-motion-cli
+      - install -Dm644 packaging/linux/com.plervo.motion.desktop /app/share/applications/com.plervo.motion.desktop
+      - install -Dm644 packaging/linux/com.plervo.motion.mime.xml /app/share/mime/packages/com.plervo.motion.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.motion.metainfo.xml.in > /app/share/metainfo/com.plervo.motion.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
