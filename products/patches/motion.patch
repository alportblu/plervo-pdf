diff --git a/packaging/linux/flatpak/com.plervo.motion.bundle.yml b/packaging/linux/flatpak/com.plervo.motion.bundle.yml
new file mode 100644
index 0000000..00965af
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.motion.bundle.yml
@@ -0,0 +1,56 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (plervo-motion-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (plervo-motion-<version>-linux-<arch>.tar.gz,
+# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
+# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
+# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
+# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
+# Wayland, xkbcommon, ALSA and Vulkan at runtime; the freedesktop runtime has all of them, and
+# the GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.plervo.motion.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime-version and finish-args identical in both (packaging-lint checks this).
+id: com.plervo.motion
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+command: plervo-motion
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu compositor and renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Audio preview and playback (cpal through ALSA, which the runtime routes to PulseAudio or
+  # PipeWire's Pulse server).
+  - --socket=pulseaudio
+  # The optional trained models (Settings ▸ Roto Brush, Settings ▸ Face Tracking) download only
+  # when the user asks, over HTTPS with curl. It also lets host agents reach the optional
+  # --control server (127.0.0.1). No telemetry: nothing else uses the network.
+  - --share=network
+  # Open/Save and import dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
+  # drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Pictures, Videos and Documents are granted so files passed by path (the
+  # command line, Open Recent, footage a project links to, Render Queue output) work in the
+  # usual places.
+  - --filesystem=xdg-pictures
+  - --filesystem=xdg-videos
+  - --filesystem=xdg-documents
+  # Deliberately not granted: home/host filesystem access.
+modules:
+  - name: plervo-motion
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/plervo-motion /app/bin/plervo-motion
+      - install -Dm755 bin/plervo-motion-cli /app/bin/plervo-motion-cli
+      - install -Dm644 share/applications/com.plervo.motion.desktop /app/share/applications/com.plervo.motion.desktop
+      - install -Dm644 share/mime/packages/com.plervo.motion.xml /app/share/mime/packages/com.plervo.motion.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.plervo.motion.metainfo.xml /app/share/metainfo/com.plervo.motion.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/plervo-motion /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
