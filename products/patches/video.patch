new file mode 100644
index 0000000..7c44f58
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.video.yml
@@ -0,0 +1,78 @@
+# Flatpak manifest for Plervo Video, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.video.yml
+#   flatpak run com.plervo.video
+#
+# The command-line tool and its MCP server run in the same sandbox, without opening a window:
+#
+#   flatpak run --command=plervo-video-cli com.plervo.video --version
+#   flatpak run --command=plervo-video-cli com.plervo.video mcp
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+id: com.plervo.video
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-video
+finish-args:
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # Audio playback and the mixer's meters (cpal over ALSA, which the runtime routes to the
+  # host's PulseAudio or PipeWire server).
+  - --socket=pulseaudio
+  # GPU access for the wgpu compositor, scopes and effects (Vulkan, or GL as a fallback).
+  - --device=dri
+  # A project refers to its media by absolute path (docs/project-files.md), and the document
+  # portal only exposes the file it was handed, not the media beside it: a project opened from
+  # ~/Videos found none of its clips (#107). So, as other video editors do, Plervo Video reads and
+  # writes the home directory (media, projects, exports, autosave next to the project) and the
+  # usual mount points of external drives, where footage often lives. Open/Save dialogs still go
+  # through the file-chooser portal; nothing outside these locations is granted.
+  - --filesystem=home
+  - --filesystem=/media
+  - --filesystem=/run/media
+  - --filesystem=/mnt
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.video` exposes it
+  # to host agents) and host-wide filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-video
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-video/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-video -p plervo-video-cli
+      - install -Dm755 target/release/plervo-video /app/bin/plervo-video
+      # The headless CLI and its stdio MCP server, as in the release bundle (#346).
+      - install -Dm755 target/release/plervo-video-cli /app/bin/plervo-video-cli
+      - install -Dm644 packaging/linux/com.plervo.video.desktop /app/share/applications/com.plervo.video.desktop
+      - install -Dm644 packaging/linux/com.plervo.video.mime.xml /app/share/mime/packages/com.plervo.video.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.video.metainfo.xml.in > /app/share/metainfo/com.plervo.video.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
