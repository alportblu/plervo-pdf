+    pub(crate) fn new_impl<A: crate::device::NdArray>(
+        array: A,
+        shape: Shape,
+        device: &Device,
+        is_variable: bool,
+    ) -> Result<Self> {
+        let n: usize = shape.elem_count();
+        let buffer_size: usize = array.shape()?.elem_count();
+        if buffer_size != n {
+            return Err(Error::ShapeMismatch { buffer_size, shape }.bt());
