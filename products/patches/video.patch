+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Plervo Video MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:
+
+    wix build plervo-video.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi
+
+  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
+-->
+<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
+  <Package
+      Name="Plervo Video"
+      Manufacturer="Maintech Solutions LLC"
+      Version="$(var.Version)"
+      UpgradeCode="530B6F84-F2AD-5386-BB7E-4C5F1598BC8F"
+      Scope="perMachine"
+      Compressed="yes"
+      Language="1033">
+    <SummaryInformation Description="Plervo Video video editor" Manufacturer="Maintech Solutions LLC" />
+    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
+         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
+    <MajorUpgrade AllowSameVersionUpgrades="yes"
+        DowngradeErrorMessage="A newer version of Plervo Video is already installed." />
+    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
+
+    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
+    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
+    <Property Id="ARPURLINFOABOUT" Value="https://plervo.com/" />
+    <Property Id="ARPURLUPDATEINFO" Value="https://plervo.com/" />
+    <Property Id="ARPHELPLINK" Value="https://buymeacoffee.com/alport" />
+
+    <StandardDirectory Id="ProgramFiles6432Folder">
+      <Directory Id="INSTALLFOLDER" Name="Plervo Video" />
+    </StandardDirectory>
+    <StandardDirectory Id="ProgramMenuFolder" />
+
+    <Feature Id="Main" Title="Plervo Video" Level="1">
+      <ComponentGroupRef Id="FilmcraftFiles" />
+    </Feature>
+    <Feature Id="PlervoLicenseFeature" Title="Licenses" Level="1"><ComponentGroupRef Id="PlervoLegalFiles" /></Feature>
+  </Package>
+
+  <Fragment>
+    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
+      <Component Id="FilmcraftApp" Guid="C8E96388-7E8B-5573-87EC-8018986BA27B">
+        <File Id="FilmcraftExe" Source="$(var.BinDir)\plervo-video.exe" KeyPath="yes">
+          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Plervo Video"
+              Description="Plervo Video video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
+              Icon="FilmcraftIcon.ico" IconIndex="0" />
+        </File>
+
+        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\plervo-video.exe" Value="[#FilmcraftExe]" Type="string" />
+      </Component>
+
+      <Component Id="FilmcraftCli">
+        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\plervo-video-cli.exe" KeyPath="yes" />
+      </Component>
+    </ComponentGroup>
+  </Fragment>
+  <Fragment>
+    <DirectoryRef Id="INSTALLFOLDER"><Directory Id="PlervoLegalDir" Name="Licenses" /></DirectoryRef>
+    <ComponentGroup Id="PlervoLegalFiles" Directory="PlervoLegalDir"><Files Include="$(var.BinDir)\Licenses\*" /></ComponentGroup>
+  </Fragment>
+</Wix>
