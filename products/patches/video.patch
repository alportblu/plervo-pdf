+#[test]
+fn individual_selection_does_not_expand_to_linked_audio() {
+    let mut s = demo();
+    let video = s.active_sequence().unwrap().video_tracks[0].items[0].id;
+    assert!(s.state.linked_selection);
+    s.execute("timeline.select", json!({"clips": [video.0]})).unwrap();
+    assert_eq!(s.state.selection.len(), 2, "ordinary selection still follows links");
+    s.execute("timeline.select", json!({"clips": [video.0], "linked": false})).unwrap();
+    assert_eq!(s.state.selection, vec![video], "Alt selection keeps only the requested clip");
+    assert!(s.state.linked_selection, "an individual gesture must not change the global preference");
+    s.state.linked_selection = false;
+    s.execute("timeline.select", json!({"clips": [video.0], "linked": true})).unwrap();
+    assert_eq!(s.state.selection, vec![video], "normal gestures respect the disabled global preference");
+}
+
+#[test]
+fn clear_current_selection_preserves_unselected_linked_audio() {
+    let mut s = demo();
+    let seq = s.active_sequence().unwrap();
+    let video = seq.video_tracks[0].items[0].clone();
+    let audio = seq.audio_tracks[0].items.iter().find(|clip| clip.link == video.link).unwrap().id;
+    // Alt-click already stores an individual selection directly; Delete must honor it.
+    s.state.selection = vec![video.id];
+    s.execute("edit.clear", json!({})).unwrap();
+    let seq = s.active_sequence().unwrap();
+    assert!(seq.find_item(video.id).is_none());
+    assert!(seq.find_item(audio).is_some(), "Delete must not remove the unselected audio");
+    seq.check().unwrap();
+    s.execute("edit.undo", json!({})).unwrap();
+    let seq = s.active_sequence().unwrap();
+    assert!(seq.find_item(video.id).is_some() && seq.find_item(audio).is_some());
+    // Preserve the existing command behavior when the caller supplies explicit clip IDs.
+    s.execute("edit.clear", json!({"clips": [video.id.0]})).unwrap();
+    let seq = s.active_sequence().unwrap();
+    assert!(seq.find_item(video.id).is_none() && seq.find_item(audio).is_none());
+}
