+    alg_id::RSA_ENCRYPTION,
+    alg_id::RSA_PSS_SHA256,
+    pss::VerifyingKey<Sha256>,
+    pss::Signature
+);
+impl_generic_rsa_verifer!(
+    RSA_PSS_SHA384,
+    alg_id::RSA_ENCRYPTION,
+    alg_id::RSA_PSS_SHA384,
+    pss::VerifyingKey<Sha384>,
+    pss::Signature
+);
+impl_generic_rsa_verifer!(
+    RSA_PSS_SHA512,
+    alg_id::RSA_ENCRYPTION,
+    alg_id::RSA_PSS_SHA512,
+    pss::VerifyingKey<Sha512>,
+    pss::Signature
