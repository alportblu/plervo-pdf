+    fn load_private_key(&self, _key: rustls::pki_types::PrivateKeyDer<'static>) -> Result<std::sync::Arc<dyn rustls::sign::SigningKey>, rustls::Error> {
+        Err(rustls::Error::General("client private keys are disabled for model downloads".into()))
