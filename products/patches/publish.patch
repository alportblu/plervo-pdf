+fn preferred_language(tags: impl IntoIterator<Item = impl AsRef<str>>) -> &'static str {
+    for tag in tags {
+        let tag = tag.as_ref().split('.').next().unwrap_or_default().replace('_', "-").to_ascii_lowercase();
+        let primary = tag.split('-').next().unwrap_or_default();
+        if primary == "en" {
+            return "";
+        }
+        if primary == "pt" {
+            return "pt-br";
+        }
+        if let Some((code, _)) = LANGUAGES.iter().find(|(code, _)| !code.is_empty() && (*code == tag || *code == primary)) {
+            return code;
+        }
+    }
+    ""
+}
