+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Plervo Publish MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:
+
+    wix build plervo-publish.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi
+
+  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by Plervo Publish,
+  and Plervo Publish offered under "Open with" for PSD/PSB and the image formats it reads (without
+  taking over the user's default app for them).
+-->
+<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
+  <Package
+      Name="Plervo Publish"
+      Manufacturer="Maintech Solutions LLC"
+      Version="$(var.Version)"
+      UpgradeCode="AE9CFB65-DD6A-5DC3-AEE0-7FF4FB70B2B0"
+      Scope="perMachine"
+      Compressed="yes"
+      Language="1033">
+    <SummaryInformation Description="Plervo Publish page layout and publishing" Manufacturer="Maintech Solutions LLC" />
+    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
+         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
+    <MajorUpgrade AllowSameVersionUpgrades="yes"
+        DowngradeErrorMessage="A newer version of Plervo Publish is already installed." />
+    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
+
+    <Icon Id="DesigncraftIcon.ico" SourceFile="$(var.IconPath)" />
+    <Property Id="ARPPRODUCTICON" Value="DesigncraftIcon.ico" />
+    <Property Id="ARPURLINFOABOUT" Value="https://plervo.com/" />
+    <Property Id="ARPURLUPDATEINFO" Value="https://plervo.com/" />
+    <Property Id="ARPHELPLINK" Value="https://buymeacoffee.com/alport" />
+
+    <StandardDirectory Id="ProgramFiles6432Folder">
+      <Directory Id="INSTALLFOLDER" Name="Plervo Publish" />
+    </StandardDirectory>
+    <StandardDirectory Id="ProgramMenuFolder" />
+
+    <Feature Id="Main" Title="Plervo Publish" Level="1">
+      <ComponentGroupRef Id="DesigncraftFiles" />
+    </Feature>
+    <Feature Id="PlervoLicenseFeature" Title="Licenses" Level="1"><ComponentGroupRef Id="PlervoLegalFiles" /></Feature>
+  </Package>
+
+  <Fragment>
+    <ComponentGroup Id="DesigncraftFiles" Directory="INSTALLFOLDER">
+      <Component Id="DesigncraftApp" Guid="03FCA9CF-D820-58EF-9E76-3C40D3858171">
+        <File Id="DesigncraftExe" Source="$(var.BinDir)\plervo-publish.exe" KeyPath="yes">
+          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Plervo Publish"
+              Description="Plervo Publish page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
+              Icon="DesigncraftIcon.ico" IconIndex="0" />
+        </File>
+
+        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\plervo-publish.exe" Value="[#DesigncraftExe]" Type="string" />
+      </Component>
+
+      <Component Id="DesigncraftCli">
+        <File Id="DesigncraftCliExe" Source="$(var.BinDir)\plervo-publish-cli.exe" KeyPath="yes" />
+      </Component>
+    </ComponentGroup>
+  </Fragment>
+  <Fragment>
+    <DirectoryRef Id="INSTALLFOLDER"><Directory Id="PlervoLegalDir" Name="Licenses" /></DirectoryRef>
+    <ComponentGroup Id="PlervoLegalFiles" Directory="PlervoLegalDir"><Files Include="$(var.BinDir)\Licenses\*" /></ComponentGroup>
+  </Fragment>
+</Wix>
