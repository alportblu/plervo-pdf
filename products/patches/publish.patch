diff --git a/packaging/linux/flatpak/com.plervo.publish.bundle.yml b/packaging/linux/flatpak/com.plervo.publish.bundle.yml
new file mode 100644
index 0000000..28ed733
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.publish.bundle.yml
@@ -0,0 +1,49 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (plervo-publish-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (plervo-publish-<version>-linux-<arch>.tar.gz,
+# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
+# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
+# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
+# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
+# Wayland, xkbcommon and Vulkan at runtime; the freedesktop runtime has all of them, and the
+# GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.plervo.publish.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime-version and finish-args identical in both (packaging-lint checks this).
+id: com.plervo.publish
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+command: plervo-publish
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for egui's renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save, Place and Export go through the file-chooser portal (rfd's xdg-portal backend)
+  # and drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Documents and Pictures are granted so files passed by path (the command
+  # line, Open Recent, linked images placed in a layout) work in the usual places.
+  - --filesystem=xdg-documents
+  - --filesystem=xdg-pictures
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.publish` exposes it
+  # to host agents) and home/host filesystem access.
+modules:
+  - name: plervo-publish
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/plervo-publish /app/bin/plervo-publish
+      - install -Dm755 bin/plervo-publish-cli /app/bin/plervo-publish-cli
+      - install -Dm644 share/applications/com.plervo.publish.desktop /app/share/applications/com.plervo.publish.desktop
+      - install -Dm644 share/mime/packages/com.plervo.publish.xml /app/share/mime/packages/com.plervo.publish.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.plervo.publish.metainfo.xml /app/share/metainfo/com.plervo.publish.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/plervo-publish /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
diff --git a/packaging/linux/flatpak/com.plervo.publish.yml b/packaging/linux/flatpak/com.plervo.publish.yml
new file mode 100644
index 0000000..64a30ab
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.publish.yml
@@ -0,0 +1,66 @@
+# Flatpak manifest for Plervo Publish, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.publish.yml
+#   flatpak run com.plervo.publish
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# The single-file .flatpak attached to each release comes from com.plervo.publish.bundle.yml,
+# which repackages the prebuilt release binaries. Keep runtime-version and finish-args identical.
+id: com.plervo.publish
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-publish
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for egui's renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save, Place and Export go through the file-chooser portal (rfd's xdg-portal backend)
+  # and drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Documents and Pictures are granted so files passed by path (the command
+  # line, Open Recent, linked images placed in a layout) work in the usual places.
+  - --filesystem=xdg-documents
+  - --filesystem=xdg-pictures
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.publish` exposes it
+  # to host agents) and home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-publish
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-publish/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-publish
+      - install -Dm755 target/release/plervo-publish /app/bin/plervo-publish
+      - install -Dm644 packaging/linux/com.plervo.publish.desktop /app/share/applications/com.plervo.publish.desktop
+      - install -Dm644 packaging/linux/com.plervo.publish.mime.xml /app/share/mime/packages/com.plervo.publish.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.publish.metainfo.xml.in > /app/share/metainfo/com.plervo.publish.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
