+    use super::*;
+    #[test]
+    fn first_supported_os_language_wins() {
+        assert_eq!(preferred_language(["xx-XX", "pt_BR.UTF-8", "en-US"]), "pt-br");
+        assert_eq!(preferred_language(["es-ES", "en-US"]), "es");
+        assert_eq!(preferred_language(["en-US", "pt-BR"]), "");
+        assert_eq!(preferred_language(["xx-XX"]), "");
+    }
+    #[test]
+    fn persisted_manual_language_is_preserved() -> Result<(), serde_json::Error> {
+        let state: crate::UiState = serde_json::from_str(r#"{"language":"es"}"#)?;
