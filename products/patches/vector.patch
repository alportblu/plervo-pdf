diff --git a/packaging/linux/flatpak/com.plervo.vector.bundle.yml b/packaging/linux/flatpak/com.plervo.vector.bundle.yml
new file mode 100644
index 0000000..a8a746d
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.vector.bundle.yml
@@ -0,0 +1,51 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (plervo-vector-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (plervo-vector-<version>-linux-<arch>.tar.gz,
+# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
+# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
+# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
+# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
+# Wayland, xkbcommon and Vulkan at runtime; the freedesktop runtime has all of them, and the
+# GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.plervo.vector.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime, runtime-version, sdk and finish-args identical in both (packaging-lint checks this).
+id: com.plervo.vector
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+command: plervo-vector
+finish-args:
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save dialogs use the file-chooser portal (rfd), and drag-and-drop uses the document
+  # portal, so broad filesystem access isn't needed. Pictures is granted for opening files by
+  # path from the command line.
+  - --filesystem=xdg-pictures
+  # Font managers (FontBase and others) activate fonts into ~/.fonts, which Flatpak does not open
+  # to a sandbox: it exposes /usr/share/fonts and ~/.local/share/fonts, and nothing else. Without
+  # this the font list holds none of the activated families, while native apps see them.
+  - --filesystem=~/.fonts:ro
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.vector` exposes it
+  # to host agents) and home/host filesystem access beyond the read-only folders above.
+modules:
+  - name: plervo-vector
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/plervo-vector /app/bin/plervo-vector
+      - install -Dm755 bin/plervo-vector-cli /app/bin/plervo-vector-cli
+      - install -Dm644 share/applications/com.plervo.vector.desktop /app/share/applications/com.plervo.vector.desktop
+      - install -Dm644 share/mime/packages/com.plervo.vector.xml /app/share/mime/packages/com.plervo.vector.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.plervo.vector.metainfo.xml /app/share/metainfo/com.plervo.vector.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/plervo-vector /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
diff --git a/packaging/linux/flatpak/com.plervo.vector.yml b/packaging/linux/flatpak/com.plervo.vector.yml
new file mode 100644
index 0000000..593f3b4
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.vector.yml
@@ -0,0 +1,59 @@
+# Flatpak manifest for Plervo Vector, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.vector.yml
+#   flatpak run com.plervo.vector
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# Release bundles (.flatpak on GitHub Releases) use com.plervo.vector.bundle.yml instead.
+id: com.plervo.vector
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-vector
+finish-args:
+  # Keep identical to com.plervo.vector.bundle.yml (the release bundle); comments there.
+  - --share=ipc
+  - --socket=wayland
+  - --socket=fallback-x11
+  - --device=dri
+  # Open/Save dialogs use the file-chooser portal (rfd), and drag-and-drop uses the document
+  # portal, so broad filesystem access isn't needed. Pictures is granted for opening files by
+  # path from the command line.
+  - --filesystem=xdg-pictures
+  - --filesystem=~/.fonts:ro
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-vector
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-vector/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-vector
+      - install -Dm755 target/release/plervo-vector /app/bin/plervo-vector
+      - install -Dm644 packaging/linux/com.plervo.vector.desktop /app/share/applications/com.plervo.vector.desktop
+      - install -Dm644 packaging/linux/com.plervo.vector.mime.xml /app/share/mime/packages/com.plervo.vector.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.vector.metainfo.xml.in > /app/share/metainfo/com.plervo.vector.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
