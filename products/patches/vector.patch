+  <developer id="ai.storyteller">
+    <name>Maintech Solutions LLC</name>
+  </developer>
+  <description>
+    <p>
+      Plervo Vector is an open-source vector illustration app. Draw with pen, shape and brush tools,
+      style art with fills, strokes, gradients and live effects, lay out artboards and type, and
+      open and save SVG and PDF.
+    </p>
