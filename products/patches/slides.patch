diff --git a/packaging/linux/flatpak/com.plervo.slides.bundle.yml b/packaging/linux/flatpak/com.plervo.slides.bundle.yml
new file mode 100644
index 0000000..333b8b3
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.slides.bundle.yml
@@ -0,0 +1,51 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (plervo-slides-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (plervo-slides-<version>-linux-<arch>.tar.gz, built
+# on Ubuntu 22.04 by package.sh with the craft-fonts embedded) instead of compiling Rust inside
+# flatpak-builder: no network and no vendored crate sources during the build, a few seconds
+# instead of 20+ minutes, and byte-for-byte the same binaries as the AppImage/deb/rpm. The script
+# unpacks the tarball into `stage/` next to a copy of this file. The binaries need glibc >= 2.35
+# and load X11, Wayland, xkbcommon, Vulkan and ALSA at runtime; the freedesktop runtime has all
+# of them, and the GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.plervo.slides.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime-version and finish-args identical in both (packaging-lint checks this).
+id: com.plervo.slides
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+command: plervo-slides
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Sound for audio and video in slide shows (cpal over ALSA, routed to PulseAudio/PipeWire by
+  # the runtime's ALSA plugin).
+  - --socket=pulseaudio
+  # Open/Save dialogs go through the file-chooser portal (rfd) and drag-and-drop through the
+  # document portal, so picked files work anywhere without broad filesystem access. Documents is
+  # granted so decks passed by path (the command line, Open Recent) work in the usual place.
+  - --filesystem=xdg-documents
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.slides` exposes it to
+  # host agents) and home/host filesystem access.
+modules:
+  - name: plervo-slides
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/plervo-slides /app/bin/plervo-slides
+      - install -Dm755 bin/plervo-slides-cli /app/bin/plervo-slides-cli
+      - install -Dm644 share/applications/com.plervo.slides.desktop /app/share/applications/com.plervo.slides.desktop
+      # .plervo-slides; the runtime's shared-mime-info already knows the PowerPoint types.
+      - install -Dm644 share/mime/packages/com.plervo.slides.xml /app/share/mime/packages/com.plervo.slides.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.plervo.slides.metainfo.xml /app/share/metainfo/com.plervo.slides.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/plervo-slides /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
