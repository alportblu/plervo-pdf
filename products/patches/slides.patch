+        let cap = db.read_faces().iter().filter(|face| face.covers('A')).map(|face| face.data().len()).min().unwrap();
+        let face = db.fallback_for_matching('A', |face| !face.is_color() && face.data().len() <= cap).unwrap();
+        assert!(face.covers('A') && face.data().len() <= cap && !face.is_color());
+        assert!(db.fallback_for_matching('A', |face| face.data().is_empty()).is_none());
+    }
+}
