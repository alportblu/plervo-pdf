+#[test]
+fn a_unicode_only_symbol_face_draws_the_double_arrow() {
+    // Model a Unicode-only Symbol face with an existing open bundled font. No installed
+    // font bytes enter the fixture, and the process-wide font database is unchanged.
+    let db = FontDb::with_font_dirs(Vec::new());
+    let face = db
+        .families()
+        .into_iter()
+        .map(|family| db.face(&family, "Regular"))
+        .find(|face| face.covers('⇒') && !face.covers('\u{f0de}'))
+        .expect("a bundled open font covers the double arrow");
+    drop(db);
+    let Ok(mut face) = Arc::try_unwrap(face) else { panic!("the isolated database must release its face") };
+    face.family = "Symbol".into();
+    let mapped = symbol_font_char(&face, "\u{f0de}", Some("Symbol"));
+    assert_eq!(mapped, Some('⇒'));
+    let glyphs = deckcraft_fonts::shape(&face, "\u{f0de}", &[], |c| mapped.unwrap_or(c));
+    assert_eq!(glyphs.len(), 1);
+    assert_eq!(glyphs[0].gid, face.glyph_for('⇒'));
+    assert_ne!(glyphs[0].gid, 0, "the arrow must not be a missing glyph");
+}
