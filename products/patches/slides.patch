+/// Read an operator-provided 256-bit capability. Never put this value in logs or command arguments.
+pub fn read_control_token(path: &std::path::Path) -> std::io::Result<String> {
+    use std::io::{Error, ErrorKind, Read};
+    let metadata = path.symlink_metadata()?;
+    if !metadata.is_file() || metadata.len() > 128 {
+        return Err(Error::new(ErrorKind::InvalidInput, "control token must be a regular file of at most 128 bytes"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o077 != 0 {
+            return Err(Error::new(ErrorKind::PermissionDenied, "control token file must be private (chmod 600)"));
+        }
+    }
+    let mut text = String::new();
+    std::fs::File::open(path)?.take(129).read_to_string(&mut text)?;
+    let token = text.trim();
+    if !valid_control_token(token) {
+        return Err(Error::new(ErrorKind::InvalidInput, "control token must contain 64 hexadecimal characters"));
+    }
+    Ok(token.to_owned())
+}
+
+pub fn valid_control_token(token: &str) -> bool {
+    token.len() == 64 && token.bytes().all(|b| b.is_ascii_hexdigit())
+}
