+/// Shape notes and page numbers with the same maintained OpenType engine as slide text.
+fn draw_note_text(s: &mut Surface, at: Point, face: &deckcraft_fonts::FontFace, font: Font, size: f32, text: &str) {
+    let Some(hb) = face.hb() else { return };
+    let mut buffer = harfrust::UnicodeBuffer::new();
+    buffer.push_str(text);
+    buffer.guess_segment_properties();
+    let shaper = face.shaper.shaper(&hb).instance(face.instance.as_ref()).build();
+    let shaped = shaper.shape(buffer, harfrust::ShapeOptions::default());
+    let boundaries: std::collections::BTreeSet<usize> = shaped.glyph_infos().iter().map(|i| i.cluster as usize).chain([text.len()]).collect();
+    let upem = font.units_per_em().max(1.0);
+    let glyphs: Vec<KrillaGlyph> = shaped
+        .glyph_infos()
+        .iter()
+        .zip(shaped.glyph_positions())
+        .map(|(info, pos)| {
+            let start = info.cluster as usize;
+            let end = boundaries.range((std::ops::Bound::Excluded(start), std::ops::Bound::Unbounded)).next().copied().unwrap_or(text.len());
+            KrillaGlyph::new(
+                GlyphId::new(info.glyph_id),
+                pos.x_advance as f32 / upem,
+                pos.x_offset as f32 / upem,
+                pos.y_offset as f32 / upem,
+                pos.y_advance as f32 / upem,
+                start..end,
+                None,
+            )
+        })
+        .collect();
+    s.draw_glyphs(at, &glyphs, font, text, size, false);
+}
