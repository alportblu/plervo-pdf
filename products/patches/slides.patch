+    #[test]
+    fn rejected_face_does_not_hide_an_acceptable_fallback() {
+        let db = FontDb::with_font_dirs(Vec::new());
+        db.add_font(epaint_default_fonts::HACK_REGULAR.to_vec());
+        let first = db.fallback_for('A', u32::MAX).unwrap();
+        let other = db.fallback_for_matching('A', |face| face.id() != first.id()).unwrap();
+        assert!(other.covers('A'));
+        assert_ne!(other.id(), first.id());
+        assert!(db.fallback_for_matching('A', |_| false).is_none());
