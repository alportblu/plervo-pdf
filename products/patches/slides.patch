new file mode 100644
index 0000000..d0a7653
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.slides.yml
@@ -0,0 +1,67 @@
+# Flatpak manifest for Plervo Slides, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.slides.yml
+#   flatpak run com.plervo.slides
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# The release's .flatpak bundles are built from com.plervo.slides.bundle.yml instead (it
+# repackages the Linux tarball); keep runtime-version and finish-args identical in both.
+id: com.plervo.slides
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-slides
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Sound for audio and video in slide shows (cpal over ALSA, routed to PulseAudio/PipeWire by
+  # the runtime's ALSA plugin).
+  - --socket=pulseaudio
+  # Open/Save dialogs go through the file-chooser portal (rfd) and drag-and-drop through the
+  # document portal, so picked files work anywhere without broad filesystem access. Documents is
+  # granted so decks passed by path (the command line, Open Recent) work in the usual place.
+  - --filesystem=xdg-documents
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.slides` exposes it to
+  # host agents) and home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-slides
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-slides/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-slides
+      - install -Dm755 target/release/plervo-slides /app/bin/plervo-slides
+      - install -Dm644 packaging/linux/com.plervo.slides.desktop /app/share/applications/com.plervo.slides.desktop
+      - install -Dm644 packaging/linux/com.plervo.slides.mime.xml /app/share/mime/packages/com.plervo.slides.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.slides.metainfo.xml.in > /app/share/metainfo/com.plervo.slides.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
