diff --git a/packaging/linux/flatpak/com.plervo.develop.bundle.yml b/packaging/linux/flatpak/com.plervo.develop.bundle.yml
new file mode 100644
index 0000000..9048b7d
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.develop.bundle.yml
@@ -0,0 +1,50 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (plervo-develop-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (plervo-develop-<version>-linux-<arch>.tar.gz,
+# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
+# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
+# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
+# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
+# Wayland, xkbcommon and Vulkan at runtime; the freedesktop runtime has all of them, and the
+# GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.plervo.develop.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime-version and finish-args identical in both (packaging-lint checks this).
+id: com.plervo.develop
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+command: plervo-develop
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # The library lives in ~/Pictures/Plervo Develop Library by default, and imports usually come from
+  # Pictures. Open/Save dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
+  # drag-and-drop through the document portal, so picked folders elsewhere work without broad
+  # filesystem access.
+  - --filesystem=xdg-pictures
+  # Deliberately not granted: home/host filesystem access, and network. The network is only for
+  # the optional SAM 3 model download (AI Object/Describe masks, docs/ai-masks.md); without it
+  # that download fails with an error and everything else works. Users who want it run
+  # `flatpak override --user --share=network com.plervo.develop`.
+modules:
+  - name: plervo-develop
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/plervo-develop /app/bin/plervo-develop
+      - install -Dm755 bin/plervo-develop-cli /app/bin/plervo-develop-cli
+      - install -Dm644 share/applications/com.plervo.develop.desktop /app/share/applications/com.plervo.develop.desktop
+      # The same MIME definitions the deb/rpm install.
+      - install -Dm644 share/mime/packages/com.plervo.develop.xml /app/share/mime/packages/com.plervo.develop.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.plervo.develop.metainfo.xml /app/share/metainfo/com.plervo.develop.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/plervo-develop /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
