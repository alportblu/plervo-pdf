+                _marker: PhantomData,
+                key: self.key.clone(),
+                scheme: self.scheme,
+            }))
+        } else {
+            None
+        }
+    }
+
+    fn algorithm(&self) -> SignatureAlgorithm {
+        SignatureAlgorithm::ED25519
+    }
+}
diff --git a/vendor/rustls-rustcrypto/src/sign/rsa.rs b/vendor/rustls-rustcrypto/src/sign/rsa.rs
