diff --git a/packaging/linux/flatpak/com.plervo.sheets.bundle.yml b/packaging/linux/flatpak/com.plervo.sheets.bundle.yml
new file mode 100644
index 0000000..d144012
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.sheets.bundle.yml
@@ -0,0 +1,49 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (plervo-sheets-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (plervo-sheets-<version>-linux-<arch>.tar.gz,
+# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
+# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
+# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
+# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
+# Wayland, xkbcommon and Vulkan/GL at runtime; the freedesktop runtime has all of them, and the
+# GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.plervo.sheets.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime, runtime-version, sdk and finish-args identical in both (packaging-lint checks this).
+id: com.plervo.sheets
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+command: plervo-sheets
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for rendering.
+  - --device=dri
+  # Open/Save dialogs use the file-chooser portal (rfd), and drag-and-drop uses the document
+  # portal, so broad filesystem access isn't needed. Documents and Downloads are granted for
+  # opening workbooks by path from the command line.
+  - --filesystem=xdg-documents
+  - --filesystem=xdg-download
+  # Deliberately not granted: network (the optional --control channel listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.sheets` exposes it to
+  # host agents) and home/host filesystem access.
+modules:
+  - name: plervo-sheets
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/plervo-sheets /app/bin/plervo-sheets
+      # Headless CLI and MCP server: `flatpak run --command=plervo-sheets-cli com.plervo.sheets`.
+      - install -Dm755 bin/plervo-sheets-cli /app/bin/plervo-sheets-cli
+      - install -Dm644 share/applications/com.plervo.sheets.desktop /app/share/applications/com.plervo.sheets.desktop
+      - install -Dm644 share/mime/packages/com.plervo.sheets.xml /app/share/mime/packages/com.plervo.sheets.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.plervo.sheets.metainfo.xml /app/share/metainfo/com.plervo.sheets.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/plervo-sheets /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
