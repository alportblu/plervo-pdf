new file mode 100644
index 0000000..907a64b
--- /dev/null
+++ b/packaging/linux/flatpak/com.plervo.sheets.yml
@@ -0,0 +1,67 @@
+# Flatpak manifest for Plervo Sheets, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.plervo.sheets.yml
+#   flatpak run com.plervo.sheets
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# The single-file .flatpak attached to each release comes from com.plervo.sheets.bundle.yml,
+# which repackages the prebuilt release binaries. Keep runtime-version and finish-args identical.
+id: com.plervo.sheets
+runtime: org.freedesktop.Platform
+runtime-version: '25.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: plervo-sheets
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for rendering.
+  - --device=dri
+  # Open/Save dialogs use the file-chooser portal (rfd), and drag-and-drop uses the document
+  # portal, so broad filesystem access isn't needed. Documents and Downloads are granted for
+  # opening workbooks by path from the command line.
+  - --filesystem=xdg-documents
+  - --filesystem=xdg-download
+  # Deliberately not granted: network (the optional --control channel listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.plervo.sheets` exposes it to
+  # host agents) and home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: plervo-sheets
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/plervo-sheets/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p plervo-sheets -p plervo-sheets-cli
+      - install -Dm755 target/release/plervo-sheets /app/bin/plervo-sheets
+      - install -Dm755 target/release/plervo-sheets-cli /app/bin/plervo-sheets-cli
+      - install -Dm644 packaging/linux/com.plervo.sheets.desktop /app/share/applications/com.plervo.sheets.desktop
+      - install -Dm644 packaging/linux/com.plervo.sheets.mime.xml /app/share/mime/packages/com.plervo.sheets.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.plervo.sheets.metainfo.xml.in > /app/share/metainfo/com.plervo.sheets.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - target-xtask
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
