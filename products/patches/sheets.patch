diff --git a/crates/ui-egui/src/plervo_support_tests.rs b/crates/ui-egui/src/plervo_support_tests.rs
new file mode 100644
index 0000000..1e0a03e
--- /dev/null
+++ b/crates/ui-egui/src/plervo_support_tests.rs
@@ -0,0 +1,66 @@
+//! The support action is visible in the header and opens only after a deliberate click.
+use egui::{Event, Modifiers, PointerButton, Pos2, RawInput, Rect, vec2};
+
+fn support_text(shapes: &[egui::epaint::ClippedShape]) -> Option<Rect> {
+    fn find(shape: &egui::epaint::Shape) -> Option<Rect> {
+        match shape {
+            egui::epaint::Shape::Text(text)
+                if ["Support", "Apoiar", "Apoyar", "Soutenir", "Unterstützen", "支援", "支持", "후원"].contains(&text.galley.job.text.as_str()) =>
+            {
+                Some(Rect::from_min_size(text.pos, text.galley.size()))
+            }
+            egui::epaint::Shape::Vec(shapes) => shapes.iter().find_map(find),
+            _ => None,
+        }
+    }
+    shapes.iter().find_map(|s| find(&s.shape).filter(|r| s.clip_rect.contains_rect(*r)))
+}
+
+#[test]
+fn support_header_is_visible_and_opens_only_the_donation_page() {
+    for width in [1024.0, 1440.0] {
+        for native in [false, true] {
+            let _ = native;
+            let ctx = egui::Context::default();
+            let mut app = crate::SheetApp::new(gridcraft_engine::Session::new(), crate::Services::default());
+            crate::SheetApp::setup_context(&ctx, false);
+            app.ui.language = crate::i18n::Language::En;
+            let mut frame = |events| {
+                let mut output = ctx.run_ui(
+                    RawInput { screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(width, 720.0))), events, ..Default::default() },
+                    |ui| {
+                        crate::ribbon::title_bar(&mut app, ui);
+                    },
+                );
+                output.textures_delta.clear();
+                output
+            };
+            let mut output = frame(vec![]);
+            for _ in 0..3 {
+                output = frame(vec![]);
+            }
+            assert!(output.platform_output.commands.is_empty(), "drawing the bar must not open a browser");
+            let text = support_text(&output.shapes).expect("support label must be visible");
+            assert!(text.min.x >= 0.0 && text.max.x <= width && text.max.y <= 100.0, "{text:?}");
+            let pos = text.center();
+            frame(vec![
+                Event::PointerMoved(pos),
+                Event::PointerButton { pos, button: PointerButton::Primary, pressed: true, modifiers: Modifiers::NONE },
+            ]);
+            let output = frame(vec![
+                Event::PointerMoved(pos),
+                Event::PointerButton { pos, button: PointerButton::Primary, pressed: false, modifiers: Modifiers::NONE },
+            ]);
+            let urls: Vec<_> = output
+                .platform_output
+                .commands
+                .iter()
+                .filter_map(|command| match command {
+                    egui::OutputCommand::OpenUrl(url) => Some((url.url.as_str(), url.new_tab)),
+                    _ => None,
+                })
+                .collect();
+            assert_eq!(urls, [("https://buymeacoffee.com/alport", true)]);
+        }
+    }
+}
