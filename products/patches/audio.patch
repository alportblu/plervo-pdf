--- /dev/null
+++ b/packaging/macos/test-plugins.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+# Exercise native plugin loading under the actual GUI/CLI hardened-runtime policies.
+# Uses original synthetic CLAP/VST3 fixtures, with no editor or native window.
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/../.." && pwd)"
+[[ "$(uname -s)" == Darwin ]] || { echo 'Requires macOS' >&2; exit 2; }
+[[ $# == 1 ]] || { echo 'Usage: test-plugins.sh EVIDENCE_DIRECTORY' >&2; exit 2; }
+mkdir -p "$1"
+OUT="$(cd "$1" && pwd)"
+WORK="$(mktemp -d "$OUT/plugin-hosts.XXXXXX")"
+trap 'rm -rf "$WORK"' EXIT
+cd "$ROOT"
+for kind in clap vst3; do
+  if [[ "$kind" == clap ]]; then
+    package=soundcraft-engine
+    test=clap_e2e
+    case=clap_insert_renders_through_the_mix
+  else
+    package=soundcraft-vst3-host
+    test=fixture_e2e
+    case=gain_processes_audio_and_follows_params
+  fi
+  cargo test --locked -j2 -p "$package" --test "$test" --no-run --message-format=json > "$OUT/$kind-build.jsonl"
+  executable="$(python3 - "$OUT/$kind-build.jsonl" "$test" <<'PY'
+import json, sys
+matches = []
+with open(sys.argv[1], encoding="utf-8") as records:
+    for line in records:
+        record = json.loads(line)
+        if record.get("reason") == "compiler-artifact" and record["target"]["name"] == sys.argv[2] and record.get("executable"):
+            matches.append(record["executable"])
+if len(matches) != 1:
+    raise SystemExit("Expected exactly one compiled fixture test executable")
+print(matches[0])
+PY
+  )"
+  for policy in gui cli; do
+    entitlement="$HERE/entitlements.plist"
+    if [[ "$policy" == cli ]]; then entitlement="$HERE/cli-entitlements.plist"; fi
+    candidate="$WORK/$kind-$policy"
+    cp "$executable" "$candidate"
+    codesign --force --sign - --options runtime --entitlements "$entitlement" "$candidate" > "$OUT/$kind-$policy-sign.txt" 2>&1
+    codesign --verify --strict "$candidate" >> "$OUT/$kind-$policy-sign.txt" 2>&1
+    codesign -d --verbose=4 "$candidate" >> "$OUT/$kind-$policy-sign.txt" 2>&1
+    "$candidate" --exact "$case" --nocapture > "$OUT/$kind-$policy-test.txt" 2>&1
+    rm "$candidate"
+    echo "$kind $policy: hardened-runtime fixture processing passed"
+  done
+done
